{
  "name": "hyperion-mcp",
  "version": "1.0.0",
  "description": "Hyperion Model Context Protocol Server",
  "tools": [
    {
      "name": "audit_protocol_invariants",
      "description": "Audit system configuration and execution against core Hyperion invariants",
      "parameters": {
        "type": "object",
        "properties": {
          "context": { "type": "string" },
          "evaluation_metric": { "type": "string" }
        },
        "required": ["context"]
      }
    },
    {
      "name": "disburse_micro_grant",
      "description": "Trigger an automated micro-escrow disbursement for verified protocol operations",
      "parameters": {
        "type": "object",
        "properties": {
          "category": { "type": "string" },
          "recipient": { "type": "string" },
          "amount_wei": { "type": "string" },
          "proof_hash": { "type": "string" }
        },
        "required": ["category", "recipient", "amount_wei"]
      }
    }
  ]
}
